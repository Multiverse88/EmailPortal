// ponytail: sqlite for dev (no docker/postgres in this env). Swap provider to
// postgresql + re-add String[]/Json for recipients & audit details when deploying.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id                String    @id @default(uuid())
  name              String
  personalEmail     String    @unique
  mailboxAddress    String    @unique
  mailboxResourceId String?   @unique
  passwordEnc       String // AES-256-GCM (needed plaintext for IMAP/SMTP)
  status            String    @default("active") // active, inactive, deleted
  storageQuota      Float     @default(5368709120) // 5 GB in bytes
  avatarUrl         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  twoFactorEnabled  Boolean         @default(false)
  twoFactorSecret   String?         // Encrypted TOTP secret (AES-256-GCM)
  preferences       String?         // JSON: { language: "id", timezone: "Asia/Jakarta", signature: "...", notifyEmail: true, notifySound: true }

  messages  MessageCache[]
  auditLogs AuditLog[]
  documents LegalDocument[]
  tickets   SupportTicket[]
  sessions  LoginSession[]
  documentMetadata DocumentMetadata[]

  @@index([mailboxAddress])
  @@index([status])
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("admin") // admin, superadmin
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([email])
}

model MessageCache {
  id         String   @id @default(uuid())
  mailboxId  String
  uid        String // IMAP UID
  messageId  String? // RFC 2822 Message-ID
  inReplyTo  String? // In-Reply-To header
  references String? // References header
  folder     String   @default("INBOX")
  subject    String?
  sender     String?
  recipients String   @default("") // comma-separated
  snippet    String?
  bodyText   String?
  bodyHtml   String?
  isRead     Boolean  @default(false)
  isStarred  Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  receivedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mailbox     Customer     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([mailboxId, uid])
  @@index([mailboxId, folder])
  @@index([mailboxId, receivedAt])
  @@index([mailboxId, isRead])
}

model Attachment {
  id        String @id @default(uuid())
  messageId String
  filename  String
  mimeType  String @default("application/octet-stream")
  size      Int    @default(0)
  path      String // relative path under STORAGE_DIR

  message MessageCache @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String // customer, mailbox, message
  targetId   String?
  details    String? // JSON string
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor    AdminUser @relation(fields: [actorId], references: [id])
  customer Customer? @relation(fields: [targetId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model LoginSession {
  id           String    @id @default(uuid())
  customerId   String
  deviceName   String    // e.g. "MacBook Pro 16\""
  deviceType   String    // "laptop" | "mobile" | "desktop"
  browser      String    // e.g. "Chrome 120"
  ipAddress    String    // e.g. "182.253.140.22"
  location     String    // e.g. "Jakarta, Indonesia"
  isCurrent    Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model LegalDocument {
  id          String            @id @default(uuid())
  customerId  String
  title       String            // e.g. "Master Service Agreement v2.pdf"
  category    String            // "Client Agreements" | "Tax Filings" | "NDA Templates"
  filename    String
  mimeType    String            @default("application/pdf")
  size        Int               @default(0) // bytes
  path        String            // file path relative to backend/storage
  status      String            @default("Reviewed") // "Urgent Review" | "Reviewed" | "Approved"
  isStarred   Boolean           @default(false)
  ownerName   String            @default("Legal Team")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]
  metadata    DocumentMetadata?

  @@index([customerId])
  @@index([category])
}

model DocumentMetadata {
  id                String   @id @default(uuid())
  documentId        String?  @unique
  customerId        String?
  docType           String   // "Akta Pendirian", "SK Kemenkumham", "NIB", "NPWP Badan", "Perjanjian Kerjasama", "Dokumen Legal"
  companyName       String?
  documentNumber    String?
  notaryName        String?
  effectiveDate     String?
  capitalAmount     String?
  businessSectors   String?  // KBLI / Bidang Usaha
  registeredAddress String?  // Alamat domisili
  keyPeople         String?  // Susunan Direksi / Komisaris / Pemegang Saham
  summary           String?  // Ringkasan klausul / pokok isi
  rawExtractedText  String?  // Disimpan aman dalam local SQLite persistent memory (zero-leakage)
  confidenceScore   Float    @default(0.95)
  verifiedBy        String?  // Nama Officer atau Admin yang memverifikasi
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  document LegalDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([docType])
}

model DocumentVersion {
  id            String        @id @default(uuid())
  documentId    String
  versionNumber String        // "v2.1", "v2.0", "v1.0"
  authorName    String
  approved      Boolean       @default(true)
  notes         String?
  createdAt     DateTime      @default(now())

  document      LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model SupportTicket {
  id           String          @id @default(uuid())
  customerId   String
  ticketNumber String          @unique // e.g. "#TK-4920"
  subject      String
  category     String          @default("Umum") // "Billing", "Document Review", "Access Revocation"
  status       String          @default("open") // "open", "resolved", "closed"
  priority     String          @default("normal") // "normal", "urgent"
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages     TicketMessage[]

  @@index([customerId])
  @@index([status])
}

model TicketMessage {
  id           String        @id @default(uuid())
  ticketId     String
  senderName   String
  senderRole   String        // "client", "agent", "system"
  senderAvatar String?
  message      String
  isInternal   Boolean       @default(false)
  createdAt    DateTime      @default(now())

  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

