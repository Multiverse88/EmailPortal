# Backend Environment Variables
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_portal

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=ms_search_key_change_me

# Storage Adapter ('local' | 's3') & Synology Drive Client Mirror
STORAGE_DRIVER=local
SYNOLOGY_DIR=/home/fullstackiteasylegal/SynologyDrive/EmailPortal_ColdStorage

# IDCloudHost Object Storage (S3-Compatible)
S3_ENDPOINT=https://is3.cloudhost.id
S3_BUCKET=emailportal
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_REGION=ap-southeast-3

# Hostinger Mail API & Provisioning (Cara 1)
HOSTINGER_DOMAIN=clienteasylegal.co.id
# API Token from hPanel (Access Management / API Tokens or Email -> API)
HOSTINGER_API_TOKEN=your_hostinger_api_token
# Optional: Order ID from hPanel (if omitted, detected automatically via API)
HOSTINGER_ORDER_ID=your_order_id_optional
HOSTINGER_MAIL_API_KEY=

# Hostinger SMTP (for onboarding notification & fallback delivery)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=admin@clienteasylegal.co.id
HOSTINGER_SMTP_PASS=your_smtp_password_here

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Encryption (for mailbox passwords)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting (FR-8). Production should keep LOGIN_RATE_LIMIT low (~10 per 15 min);
# raise it only for local dev / e2e runs where the whole suite shares one IP.
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=1000
MAILBOX_QUOTA=100
STORAGE_DIR=./storage
SYNC_INTERVAL_MS=30000
